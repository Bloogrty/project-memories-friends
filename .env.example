# Copy to .env.local for local development. On Vercel, set these under
# Project > Settings > Environment Variables, then redeploy.
# Blank values use the default. Every value is checked when the app starts,
# and a wrong one stops it with a message naming the variable.
#
# Older names (e.g. NEXT_PUBLIC_UPLOAD_RETRIES) still work, so an existing
# deployment needs no changes. The server log lists any old names in use.
# Never prefix a secret with NEXT_PUBLIC_.

# ---------- Storage and security ----------

# Where photos go: local = folder on this computer, webdav = Synology NAS. Default: local in dev, webdav in production.
STORAGE_DRIVER=local
# Folder used by the local driver, relative to the project.
LOCAL_STORAGE_DIR=.local-storage
# Tailscale Funnel address of the NAS, e.g. https://<nas>.<tailnet>.ts.net. Required when STORAGE_DRIVER=webdav.
WEBDAV_URL=
# Dedicated NAS user. Required when STORAGE_DRIVER=webdav.
WEBDAV_USERNAME=
# That user's password. Required when STORAGE_DRIVER=webdav.
WEBDAV_PASSWORD=
# Shared folder / base path on the NAS (double underscore).
WEBDAV_ROOT=/project__memories
# Required, 16+ characters. Protects the /admin page and API. Generate one and keep it private.
ADMIN_SECRET=
# Reject larger uploads, photo or video. Must stay under Vercel's 4.5 MB limit (maximum 4.4).
MAX_UPLOAD_MB=4
# Longest allowed guest display name, in characters.
MAX_GUEST_NAME_LENGTH=40
# Accepted upload types, comma-separated, after browser compression.
ALLOWED_MIME_TYPES=image/jpeg,image/webp
# Accepted video types, comma-separated.
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/webm
# JPEG quality (1-100) of the stored photo.
STORE_JPEG_QUALITY=85
# Long edge of gallery thumbnails, in pixels.
THUMB_MAX_EDGE_PX=400
# JPEG quality (1-100) of thumbnails.
THUMB_JPEG_QUALITY=70
# Remove EXIF/GPS metadata from stored photos: true or false.
STRIP_EXIF=true
# How long a viewer's browser may keep a photo, in seconds.
PHOTO_CACHE_SECONDS=86400
# Server logs: false turns off all logs, including errors.
LOG_ENABLED=true
# Least important level to show: debug (everything, including each NAS call), info, warn, or error.
LOG_LEVEL=info

# ---------- Session: when guests can upload ----------

# daily = a new album every day (link /d/YYYY-MM-DD; the home page opens today's).
# event = one album with a fixed start and end (link /d/<EVENT_CODE>; the home page opens it).
SESSION_MODE=daily
# Timezone for all day and event times.
APP_TIMEZONE=Asia/Jakarta
# Daily mode: when each day's album opens (24-hour HH:MM, in APP_TIMEZONE).
DAY_OPEN_TIME=00:00
# Daily mode: when it closes. At or before the open time means the next day.
DAY_CLOSE_TIME=23:59
# Event mode: the album's code, used in the link and as its folder on the NAS. Lowercase letters, digits and dashes.
EVENT_CODE=event
# Event mode, required: when uploads open. ISO date and time, e.g. 2026-12-20T16:00 (read in APP_TIMEZONE) or 2026-12-20T16:00+07:00.
EVENT_START=
# Event mode, required: when uploads close. Same format, later than EVENT_START.
EVENT_END=
# Gallery after closing: hidden or readonly. Blank = hidden in daily mode, readonly in event mode.
# Before an event starts, its gallery is always on view (with a "not started yet" message).
GALLERY_AFTER_CLOSE=
# Photos each guest may take per session (one day, or the whole event).
MAX_PHOTOS_PER_PERSON=30
# Videos each guest may take per session. Counted separately from photos. 0 turns video off.
MAX_VIDEOS_PER_PERSON=5

# ---------- Branding ----------

# Album name: browser tab, and the page header (above the date in daily mode, the main title in event mode).
APP_TITLE=Memories
# Optional line under the title, e.g. "Andi & Sari · 20 December 2026". Blank = none.
APP_SUBTITLE=
# Main colour of buttons and links, as #rrggbb. Hover and dark-mode shades are worked out from it. Blank = the built-in terracotta.
THEME_PRIMARY=
# Optional logo above the title: a file in public/ (e.g. /logo.png) or a full https:// address. Blank = none.
LOGO_URL=
# Optional wide banner image at the top of the album page. Same format as LOGO_URL. Blank = none.
COVER_IMAGE_URL=
# Language of all guest-facing text: en (English) or id (Bahasa Indonesia).
UI_LANGUAGE=en
# Event mode: replaces the line under "not started yet". Blank = "You can take photos from <start time>."
EVENT_NOT_STARTED_TEXT=
# Event mode: replaces the line under "has ended". Blank = "Uploads are closed. Thanks for sharing your photos!"
EVENT_ENDED_TEXT=

# ---------- Guest page ----------

# false = camera only, true = also allow choosing from the phone's gallery.
ALLOW_GALLERY_UPLOAD=false
# true = in-app camera with no "Use photo" step (https only, lower quality). false = always the phone's own camera.
IN_APP_PHOTO_CAMERA=true
# Gallery auto-refresh interval, in seconds.
GALLERY_POLL_SECONDS=10

# ---------- Photo compression in the browser ----------

# Long edge after browser compression, in pixels.
NEXT_PUBLIC_CLIENT_MAX_EDGE_PX=2048
# Starting JPEG quality in the browser, above 0 up to 1.
NEXT_PUBLIC_CLIENT_JPEG_QUALITY=0.8
# Lower the quality step by step until a photo is under this size, in MB.
NEXT_PUBLIC_CLIENT_TARGET_MB=1.5

# ---------- Video ----------

# Longest video clip, in seconds. Longer clips also need a lower bitrate to fit the upload limit.
VIDEO_MAX_SECONDS=15
# Video recording bitrate, in kilobits per second.
VIDEO_BITRATE_KBPS=1800
# Requested long edge of recorded video, in pixels.
VIDEO_MAX_EDGE_PX=1280
# Stop recording early once a clip reaches this size, in MB. Keep it below MAX_UPLOAD_MB.
VIDEO_TARGET_MB=3.6
# true = guests watch a clip and choose Retake or Use video. false = it uploads as soon as recording stops.
REVIEW_VIDEO_BEFORE_UPLOAD=false

# ---------- Live Wall: full-screen slideshow at /wall for a projector or TV ----------

# true = the /wall page exists. false = it shows "not found".
FEATURE_LIVE_WALL=false
# Optional password for the wall: then it only opens as /wall?key=<this value>. Blank = no key needed.
LIVE_WALL_KEY=
# Seconds each photo stays on screen. Videos play to the end.
LIVE_WALL_INTERVAL=6
# How often the wall checks for new photos, in seconds. New ones are shown next.
LIVE_WALL_POLL_SECONDS=10
# The wall cycles through this many of the newest photos and videos.
LIVE_WALL_MAX_ITEMS=100
# Optional background music: MP3 links, comma-separated, played in order and repeated.
# Files in public/music/ are written as /music/song.mp3. Blank = no music.
# With music, the wall shows a Start button: browsers only play sound after a click.
LIVE_WALL_MUSIC_URLS=
# Music volume, 0 to 1.
LIVE_WALL_MUSIC_VOLUME=0.6
# true = guests' videos play with their sound (the music gets quieter meanwhile). false = videos play muted.
LIVE_WALL_VIDEO_SOUND=false

# ---------- Background uploads ----------

# How many background uploads run at once per phone. Higher is faster but works the NAS harder.
UPLOAD_CONCURRENCY=2
# How many times a failed upload retries by itself before showing a Retry button.
UPLOAD_RETRIES=3
